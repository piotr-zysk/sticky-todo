<Window x:Class="StickyTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StickyTodo"
        PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated"
        PreviewTextInput="Window_PreviewTextInput"
        Title="Sticky Todo" Icon="app.ico" Width="800" SizeToContent="Height" MinWidth="320"
        Topmost="True" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged"
        Background="#FFF9EDB5" BorderBrush="#FFE0CE88" BorderThickness="1"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" FontSize="13" Foreground="#FF353225">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <local:RoundedBorder CornerRadius="8" Background="{TemplateBinding Background}"
                                 BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <AdornerDecorator><ContentPresenter/></AdornerDecorator>
            </local:RoundedBorder>
        </ControlTemplate>
    </Window.Template>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF80651C"/>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TaskForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#44000000"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel x:Name="RootDock">
        <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Height="32" Background="#FFEEDD9A" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                <TextBlock Text="To do" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Opacity="0.75"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SyncButton" Style="{StaticResource FlatBtn}" Content="&#x21BB;" FontSize="19" Visibility="Collapsed"
                        ToolTip="Never synced" AutomationProperties.Name="Sync with Google Drive" Click="Sync_Click"/>
                <Button Style="{StaticResource FlatBtn}" Content="+" FontWeight="Bold" ToolTip="Add task" Click="AddToggle_Click"/>
                <Button Style="{StaticResource FlatBtn}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="2"/>
                        </StackPanel.RenderTransform>
                        <StackPanel.LayoutTransform>
                            <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                        </StackPanel.LayoutTransform>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Ellipse Width="3" Height="3" Margin="0,3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatBtn}" Content="&#x2013;" ToolTip="Minimize" Click="Minimize_Click"/>
                <Button Style="{StaticResource FlatBtn}" Content="&#x00D7;" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <local:TaskListControl x:Name="TaskView"/>
    </DockPanel>
</Window>
