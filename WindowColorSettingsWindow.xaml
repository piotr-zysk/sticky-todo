<Window x:Class="StickyTodo.WindowColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Icon="app.ico" Width="340" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Topmost="True" Background="#FFF8F4E6" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Background color" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Border x:Name="ColorPreview" Height="42" CornerRadius="5" BorderBrush="Gray" BorderThickness="1"/>
        <TextBlock x:Name="InheritanceStatus" Margin="0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Red" VerticalAlignment="Center"/>
            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Color_Changed" Margin="0,5" AutomationProperties.Name="Red"/>
            <TextBlock Grid.Row="1" Text="Green" VerticalAlignment="Center"/>
            <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Color_Changed" Margin="0,5" AutomationProperties.Name="Green"/>
            <TextBlock Grid.Row="2" Text="Blue" VerticalAlignment="Center"/>
            <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Color_Changed" Margin="0,5" AutomationProperties.Name="Blue"/>
        </Grid>
        <Label Content="Hex color (#RRGGBB)" Target="{Binding ElementName=HexColor}" Padding="0" Margin="0,8,0,5"/>
        <TextBox x:Name="HexColor" MaxLength="7" Padding="6" TextChanged="Hex_Changed"/>
        <TextBlock x:Name="ColorError" Text="Enter a color in #RRGGBB format." Foreground="#FFB00020" Visibility="Collapsed" Margin="0,4"/>
        <TextBlock Text="Applies to text, subtasks, and descendant windows. Children with their own color keep it." TextWrapping="Wrap" Margin="0,10"/>
        <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click" Padding="10,5" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" MinWidth="70" Padding="10,5"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="70" Padding="10,5" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
