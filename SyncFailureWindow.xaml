<Window x:Class="StickyTodo.SyncFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google sync failed" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="#FFFFFCF0" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Your changes are saved locally. Google sync failed." TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="Retry" Click="Retry_Click" IsDefault="True" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="CloseAnywayButton" Content="Close anyway" Click="CloseAnyway_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="CancelCloseButton" Content="Cancel close" IsCancel="True" Padding="12,6"/>
        </StackPanel>
    </StackPanel>
</Window>
