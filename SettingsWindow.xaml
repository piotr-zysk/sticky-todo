<Window x:Class="StickyTodo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="Height" Width="760" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FFFFFCF0" Foreground="#FF353225" FontFamily="Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid x:Name="RootGrid" Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Text="Background color" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Border x:Name="ColorPreview" Height="42" CornerRadius="5" BorderBrush="#FFAAA597" BorderThickness="1" Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Red" VerticalAlignment="Center"/>
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Color_Changed" Margin="0,5" AutomationProperties.Name="Red"/>
                <TextBlock Grid.Row="1" Text="Green" VerticalAlignment="Center"/>
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Color_Changed" Margin="0,5" AutomationProperties.Name="Green"/>
                <TextBlock Grid.Row="2" Text="Blue" VerticalAlignment="Center"/>
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Color_Changed" Margin="0,5" AutomationProperties.Name="Blue"/>
            </Grid>
            <Label Content="Hex color (#RRGGBB)" Target="{Binding ElementName=HexColor}" Padding="0" Margin="0,10,0,5"/>
            <DockPanel>
                <Button Content="Default color" Click="DefaultColor_Click" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0"/>
                <TextBox x:Name="HexColor" MaxLength="7" Padding="6" TextChanged="Hex_Changed"/>
            </DockPanel>
            <TextBlock x:Name="ColorError" Text="Enter a color in #RRGGBB format." Foreground="#FFB00020" Visibility="Collapsed" Margin="0,4,0,0"/>
            <TextBlock Text="Application opacity" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:0}%}"/>
                <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed" AutomationProperties.Name="Application opacity"/>
            </DockPanel>
            <TextBlock Text="Zoom" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <ComboBox x:Name="ZoomLevel" Width="100" HorizontalAlignment="Left" SelectionChanged="Zoom_Changed" AutomationProperties.Name="Zoom"/>
            <CheckBox x:Name="BoldHighPriority" Content="Bold high-priority items" Checked="BoldHighPriority_Changed" Unchecked="BoldHighPriority_Changed" Margin="0,16,0,0"/>
            <TextBlock Text="Changes are previewed on your sticky note." Margin="0,10,0,0" Foreground="#FF706A58"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="Behavior" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Item delete retention (seconds)" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox x:Name="DeleteRetentionSeconds" Grid.Column="1" MaxLength="10" Margin="0,4" TextChanged="NumericSettings_Changed" AutomationProperties.Name="Item delete retention in seconds"/>
                <TextBlock x:Name="RetentionError" Grid.Row="1" Grid.ColumnSpan="2" Text="Enter a whole number of 0 or more." Foreground="#FFB00020" Visibility="Collapsed" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Text="Max number of items to display (1–100)" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox x:Name="MaxItemsToDisplay" Grid.Row="2" Grid.Column="1" MaxLength="3" Margin="0,4" TextChanged="NumericSettings_Changed" AutomationProperties.Name="Max number of items to display"/>
                <TextBlock x:Name="MaxItemsError" Grid.Row="3" Grid.ColumnSpan="2" Text="Enter a whole number from 1 to 100." Foreground="#FFB00020" Visibility="Collapsed" Margin="0,0,0,4"/>
                <Label Grid.Row="4" Content="Details autosave interval (seconds)" Target="{Binding ElementName=DetailsAutoSaveIntervalSeconds}" Padding="0" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBox x:Name="DetailsAutoSaveIntervalSeconds" Grid.Row="4" Grid.Column="1" MaxLength="4" Margin="0,4" TextChanged="NumericSettings_Changed" AutomationProperties.Name="Details autosave interval in seconds"/>
                <TextBlock x:Name="AutoSaveIntervalError" Grid.Row="5" Grid.ColumnSpan="2" Text="Enter a whole number from 0 to 3600." Foreground="#FFB00020" Visibility="Collapsed" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="0 disables autosave; maximum 3600 seconds (1 hour)." TextWrapping="Wrap" Foreground="#FF706A58"/>
            </Grid>
            <TextBlock Text="Google Drive sync" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <TextBlock x:Name="GoogleStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel x:Name="GoogleActions" Margin="0,0,0,8">
                <Button x:Name="ImportGoogleButton" Content="Import credentials…" Click="ImportGoogle_Click" Padding="8,5" Margin="0,0,6,6"/>
                <Button x:Name="GoogleSignInButton" Content="Sign in to Google" Click="GoogleSignIn_Click" Padding="8,5" Margin="0,0,6,6"/>
                <Button x:Name="GoogleSignOutButton" Content="Sign out" Click="GoogleSignOut_Click" Padding="8,5" Margin="0,0,0,6"/>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Text="Import the OAuth Desktop app JSON from your Google Cloud project (Drive API enabled). Use the same client on each computer. Account changes take effect immediately." Foreground="#FF706A58" Margin="0,0,0,8"/>
            <Button Content="Google setup instructions" Click="GoogleHelp_Click" HorizontalAlignment="Left" Padding="8,5"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0">
            <Button x:Name="ResetButton" Content="Reset all" Click="Reset_Click" Padding="10,5" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="12,5" Margin="8,0"/>
                <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" Padding="12,5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>
